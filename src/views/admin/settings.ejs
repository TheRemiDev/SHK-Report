<%- include('../partials/head') %>
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <h1 class="text-2xl font-bold text-ink-900">Paramètres de l’entreprise</h1>
    <p class="mt-1 text-sm text-ink-400">Ces informations apparaissent dans l’interface et sur les rapports PDF.</p>

    <%- include('../partials/flash') %>

    <form action="/admin/settings" method="post" class="card mt-6 grid grid-cols-1 gap-4 p-6 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label class="field-label" for="company_name">Nom de l’entreprise</label>
        <input class="field-input" type="text" id="company_name" name="company_name" value="<%= settings.company_name %>" required />
      </div>
      <div class="sm:col-span-2">
        <label class="field-label" for="company_address">Adresse</label>
        <input class="field-input" type="text" id="company_address" name="company_address" value="<%= settings.company_address || '' %>" />
      </div>
      <div>
        <label class="field-label" for="company_email">Email de contact</label>
        <input class="field-input" type="email" id="company_email" name="company_email" value="<%= settings.company_email || '' %>" />
      </div>
      <div>
        <label class="field-label" for="company_phone">Téléphone</label>
        <input class="field-input" type="text" id="company_phone" name="company_phone" value="<%= settings.company_phone || '' %>" />
      </div>
      <div>
        <label class="field-label" for="company_website">Site web</label>
        <input class="field-input" type="text" id="company_website" name="company_website" value="<%= settings.company_website || '' %>" />
      </div>
      <div class="sm:col-span-2">
        <button type="submit" class="btn-accent">Enregistrer</button>
      </div>
    </form>

    <div class="card mt-6 p-6">
      <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Logo</h2>
      <p class="mt-2 text-sm text-ink-500">
        Le logo importé ici est utilisé tel quel, partout dans l’application et sur les documents PDF
        (page de connexion, en-têtes, page de garde des rapports, favicon…), mis à l’échelle automatiquement selon le contexte.
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-6">
        <div class="flex h-24 w-48 items-center justify-center rounded-xl border border-dashed border-ink-200 bg-ink-50 p-3">
          <% if (companyLogoUrl) { %>
            <img src="<%= companyLogoUrl %>" alt="Logo actuel" class="max-h-full max-w-full object-contain" />
          <% } else { %>
            <p class="text-center text-xs text-ink-400">Aucun logo importé pour l’instant</p>
          <% } %>
        </div>

        <div class="flex flex-col gap-3">
          <form action="/admin/settings/logo" method="post" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
            <input type="file" name="logo" accept=".png,.jpg,.jpeg,.webp,.svg,image/png,image/jpeg,image/webp,image/svg+xml" required
              class="text-sm text-ink-600 file:mr-3 file:rounded-lg file:border-0 file:bg-ink-900 file:px-3.5 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-ink-700" />
            <button type="submit" class="btn-accent">Importer</button>
          </form>
          <% if (companyLogoUrl) { %>
            <form action="/admin/settings/logo/remove" method="post" data-confirm="Retirer le logo actuel ?">
              <button type="submit" class="btn-ghost !px-0 text-xs text-red-600 hover:bg-transparent hover:underline">Retirer le logo</button>
            </form>
          <% } %>
          <p class="text-xs text-ink-400">PNG, JPEG, WEBP ou SVG — 4 Mo maximum.</p>
        </div>
      </div>
    </div>
  </main>
<%- include('../partials/foot') %>
