<%- include('partials/head') %>
  <div class="flex min-h-screen flex-col bg-black">
    <div class="flex flex-1 items-center justify-center px-4 py-16">
      <div class="w-full max-w-[380px]">
        <div class="flex justify-center">
          <%- include('partials/logo-mark', { variant: 'compact', className: 'h-6 w-auto text-white' }) %>
        </div>

        <p class="mt-6 text-center text-[11px] font-semibold uppercase tracking-[0.2em] text-ink-400">
          Portail interne — accès réservé
        </p>

        <div class="mt-8 rounded-xl border border-white/10 bg-ink-900 p-8 shadow-[0_1px_0_0_rgba(255,255,255,0.04)_inset,0_20px_50px_-20px_rgba(0,0,0,0.6)]">
          <h1 class="text-lg font-semibold text-white">Connexion</h1>
          <p class="mt-1 text-sm text-ink-400">Rapports d’intervention DataCenter.</p>

          <div class="mt-5">
            <%- include('partials/flash') %>
          </div>

          <form action="/login" method="post" class="mt-5 space-y-4">
            <div>
              <label class="block text-xs font-medium text-ink-300 mb-1.5" for="email">Adresse email</label>
              <input
                class="w-full rounded-md border border-white/10 bg-black/20 px-3.5 py-2.5 text-sm text-white placeholder-ink-500 shadow-inner transition focus:border-teal-500/60 focus:outline-none focus:ring-1 focus:ring-teal-500/40"
                type="email" id="email" name="email" required autofocus autocomplete="username" placeholder="prenom.nom@shiftek.fr" />
            </div>
            <div>
              <label class="block text-xs font-medium text-ink-300 mb-1.5" for="password">Mot de passe</label>
              <input
                class="w-full rounded-md border border-white/10 bg-black/20 px-3.5 py-2.5 text-sm text-white placeholder-ink-500 shadow-inner transition focus:border-teal-500/60 focus:outline-none focus:ring-1 focus:ring-teal-500/40"
                type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••" />
            </div>
            <button type="submit" class="w-full rounded-md bg-white py-2.5 text-sm font-semibold text-ink-900 transition hover:bg-ink-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900">
              Se connecter
            </button>
          </form>
        </div>

        <p class="mt-6 text-center text-xs text-ink-500">
          Accès non autorisé interdit. En cas de difficulté, contactez votre administrateur.
        </p>
      </div>
    </div>

    <footer class="border-t border-white/5 px-4 py-5 text-center text-xs text-ink-500">
      &copy; <%= new Date().getFullYear() %> <%= companyName %>
    </footer>
  </div>
<%- include('partials/foot') %>
