<%
  // locals attendus :
  //   size  : 'sm' | 'md' | 'lg' | 'xl' (défaut 'md') — hauteur du logo / taille du texte de repli
  //   dark  : true si affiché sur un fond sombre (défaut false)
  //   extraClass : classes additionnelles (marges, etc.)
  const _size = typeof size !== 'undefined' ? size : 'md';
  const _dark = typeof dark !== 'undefined' ? !!dark : false;
  const _extra = typeof extraClass !== 'undefined' ? extraClass : '';
  const _logoUrl = typeof companyLogoUrl !== 'undefined' ? companyLogoUrl : null;
  const _name = typeof companyName !== 'undefined' ? companyName : 'Shiftek Hosting';

  const SIZES = {
    sm: { img: 'h-7', text: 'text-base' },
    md: { img: 'h-8', text: 'text-lg' },
    lg: { img: 'h-9', text: 'text-xl' },
    xl: { img: 'h-16', text: 'text-4xl' },
  };
  const _s = SIZES[_size] || SIZES.md;
%>
<% if (_logoUrl) { %>
  <% if (_dark) { %>
    <span class="inline-flex items-center rounded-lg bg-white px-3 py-1.5 shadow-sm <%= _extra %>">
      <img src="<%= _logoUrl %>" alt="<%= _name %>" class="<%= _s.img %> w-auto object-contain" />
    </span>
  <% } else { %>
    <img src="<%= _logoUrl %>" alt="<%= _name %>" class="<%= _s.img %> w-auto object-contain <%= _extra %>" />
  <% } %>
<% } else { %>
  <span class="inline-flex items-center font-extrabold leading-none tracking-tight <%= _s.text %> <%= _dark ? 'text-white' : 'text-ink-900' %> <%= _extra %>">
    <%= _name %>
  </span>
<% } %>
