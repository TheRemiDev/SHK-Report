<%
  // locals attendus : className (obligatoire), variant ('compact' par défaut | 'full')
  const _variant = typeof variant !== 'undefined' ? variant : 'compact';
%>
<% if (_variant === 'full') { %>
<svg viewBox="0 8 277.08 52" class="<%= className %>" fill="none" aria-hidden="true">
  <rect x="0" y="8" width="6" height="34" fill="#0F9E8F" />
  <text x="18" y="38" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="30" fill="currentColor">SHIFTEK</text>
  <text x="18" y="58" font-family="Arial, Helvetica, sans-serif" font-weight="600" font-size="9.5" letter-spacing="3.2" fill="currentColor" opacity="0.55">HOSTING &#183; DATACENTER SERVICES</text>
</svg>
<% } else { %>
<svg viewBox="0 2 118.34 27" class="<%= className %>" fill="none" aria-hidden="true">
  <rect x="0" y="2" width="5" height="26" fill="#0F9E8F" />
  <text x="15" y="24" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="24" fill="currentColor">SHIFTEK</text>
</svg>
<% } %>
