<%
  const detours = trip ? JSON.parse(trip.detours || '[]') : [];
  const tripMode = trip && trip.return_address ? 'aller_retour' : 'simple';
%>
<%- include('../partials/head') %>
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <a href="/trips" class="btn-ghost !px-2"><svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"/></svg></a>
      <div>
        <h1 class="text-2xl font-bold text-ink-900"><%= trip ? 'Modifier la fiche de route' : 'Nouvelle fiche de route' %></h1>
        <p class="mt-1 text-sm text-ink-400"><%= trip ? trip.reference : 'Une référence sera générée automatiquement.' %></p>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <form method="post" action="<%= trip ? '/trips/' + trip.id : '/trips' %>" enctype="multipart/form-data" class="mt-6 space-y-6">
      <section class="card p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Trajet</h2>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="trip_date">Date</label>
            <input class="field-input" type="date" id="trip_date" name="trip_date" required value="<%= trip ? trip.trip_date : '' %>" />
          </div>
          <div>
            <label class="field-label" for="technician_name">Technicien</label>
            <input class="field-input" type="text" id="technician_name" name="technician_name" required
              value="<%= trip ? trip.technician_name : (currentUser ? currentUser.fullName : '') %>" />
          </div>
          <div>
            <label class="field-label" for="departure_address">Adresse de départ</label>
            <input class="field-input" type="text" id="departure_address" name="departure_address" required value="<%= trip ? trip.departure_address : '' %>" />
          </div>
          <div>
            <label class="field-label" for="arrival_address">Adresse d’arrivée</label>
            <input class="field-input" type="text" id="arrival_address" name="arrival_address" required value="<%= trip ? trip.arrival_address : '' %>" />
          </div>
        </div>

        <div class="mt-4" id="trip-mode-section">
          <label class="field-label">Type de trajet</label>
          <div class="inline-flex flex-wrap gap-1 rounded-lg border border-ink-100 bg-ink-50 p-1" id="trip-mode-toggle">
            <label class="cursor-pointer">
              <input type="radio" name="trip_mode" value="simple" class="peer sr-only" <%= tripMode === 'simple' ? 'checked' : '' %> />
              <span class="block rounded-md px-3 py-1.5 text-sm font-medium text-ink-500 transition peer-checked:bg-white peer-checked:text-ink-900 peer-checked:shadow-sm">Aller simple</span>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="trip_mode" value="aller_retour" class="peer sr-only" <%= tripMode === 'aller_retour' ? 'checked' : '' %> />
              <span class="block rounded-md px-3 py-1.5 text-sm font-medium text-ink-500 transition peer-checked:bg-white peer-checked:text-ink-900 peer-checked:shadow-sm">Avancé (aller-retour)</span>
            </label>
          </div>

          <div class="mt-3 <%= tripMode === 'aller_retour' ? '' : 'hidden' %>" data-trip-panel="aller_retour">
            <label class="field-label" for="return_address">Adresse de retour</label>
            <div class="flex gap-2">
              <input class="field-input" type="text" id="return_address" name="return_address" <%= tripMode === 'aller_retour' ? '' : 'disabled' %>
                value="<%= trip ? (trip.return_address || '') : '' %>" placeholder="Ex. 6 Rue Ar Prat, 29760 Penmarch" />
              <button type="button" id="copy-departure-address" class="btn-secondary whitespace-nowrap">Identique au départ</button>
            </div>
            <p class="mt-1 text-xs text-ink-400">Renseignez-la si le retour ne se fait pas vers l’adresse de départ.</p>
          </div>
        </div>

        <div class="mt-4">
          <label class="field-label">Détours (optionnel)</label>
          <div id="detours-list" class="space-y-2">
            <% (detours.length ? detours : ['']).forEach(function (d) { %>
              <div class="flex gap-2 detour-row">
                <input class="field-input" type="text" name="detour" placeholder="Adresse intermédiaire" value="<%= d %>" />
                <button type="button" class="btn-ghost !px-2.5 detour-remove" aria-label="Retirer">
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm4-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                </button>
              </div>
            <% }) %>
          </div>
          <button type="button" id="add-detour" class="btn-secondary mt-2 !py-1.5">+ Ajouter un détour</button>
        </div>
      </section>

      <section class="card p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Distance &amp; frais</h2>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="total_km">Distance totale parcourue (km)</label>
            <input class="field-input" type="number" step="0.1" min="0" id="total_km" name="total_km" value="<%= trip ? (trip.total_km ?? '') : '' %>" />
          </div>
          <div>
            <label class="field-label" for="total_amount">Montant total dépensé (€)</label>
            <input class="field-input" type="number" step="0.01" min="0" id="total_amount" name="total_amount" value="<%= trip ? (trip.total_amount ?? '') : '' %>" />
          </div>
          <div class="sm:col-span-2">
            <label class="field-label" for="purpose">Motif du déplacement</label>
            <input class="field-input" type="text" id="purpose" name="purpose" value="<%= trip ? (trip.purpose || '') : '' %>" placeholder="Ex. Intervention chez le client ACME Corp" />
          </div>
          <div class="sm:col-span-2">
            <label class="field-label" for="notes">Notes</label>
            <textarea class="field-textarea" id="notes" name="notes" rows="3"><%= trip ? (trip.notes || '') : '' %></textarea>
          </div>
        </div>
      </section>

      <section class="card p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Justificatifs</h2>
        <p class="mt-1 text-xs text-ink-400">Tickets de péage, carburant, parking… — JPEG, PNG ou WEBP, 8 Mo max par image, 10 images max.</p>

        <% if (trip && photos && photos.length) { %>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <% photos.forEach(function (p) { %>
              <label class="group relative block overflow-hidden rounded-xl border border-ink-100">
                <img src="/uploads/photos/<%= p %>" class="h-28 w-full object-cover" alt="Justificatif" />
                <span class="absolute inset-0 flex items-center justify-center gap-2 bg-ink-900/0 opacity-0 transition group-has-[:checked]:bg-red-900/50 group-has-[:checked]:opacity-100">
                  <span class="rounded-full bg-white px-2 py-1 text-xs font-semibold text-red-700">Supprimé</span>
                </span>
                <input type="checkbox" name="remove_photos" value="<%= p %>" class="absolute right-1.5 top-1.5 h-4 w-4 rounded border-white" />
              </label>
            <% }) %>
          </div>
          <p class="mt-1 text-xs text-ink-400">Cochez un justificatif pour le retirer de la fiche.</p>
        <% } %>

        <div class="mt-4">
          <input class="field-input" type="file" id="photos" name="photos" accept="image/jpeg,image/png,image/webp" multiple />
          <div id="photo-preview" class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4"></div>
        </div>
      </section>

      <section class="card p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Signature</h2>
        <div class="mt-4 max-w-sm">
          <div class="signature-pad rounded-xl border border-dashed border-ink-200 bg-ink-50" data-target="signature_data">
            <canvas class="h-40 w-full touch-none select-none cursor-crosshair rounded-xl bg-white" width="500" height="220"></canvas>
          </div>
          <button type="button" class="btn-secondary mt-2 !py-1.5 signature-clear">Effacer</button>
          <input type="hidden" name="signature_data" value="<%= trip ? (trip.signature_data || '') : '' %>" />
        </div>
      </section>

      <div class="flex items-center justify-end gap-3">
        <a href="/trips" class="btn-secondary">Annuler</a>
        <button type="submit" class="btn-accent"><%= trip ? 'Enregistrer les modifications' : 'Créer la fiche' %></button>
      </div>
    </form>
  </main>
<%- include('../partials/foot') %>
