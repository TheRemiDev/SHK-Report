<%- include('partials/head') %>
  <%- include('partials/nav') %>

  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <a href="/" class="btn-ghost !px-2"><svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"/></svg></a>
      <div>
        <h1 class="text-2xl font-bold text-ink-900"><%= intervention ? 'Modifier le rapport' : 'Nouveau rapport d’intervention' %></h1>
        <p class="mt-1 text-sm text-ink-400"><%= intervention ? intervention.reference : 'Une référence sera générée automatiquement à l’enregistrement.' %></p>
      </div>
    </div>

    <%- include('partials/flash') %>

    <form
      method="post"
      action="<%= intervention ? '/interventions/' + intervention.id : '/interventions' %>"
      enctype="multipart/form-data"
      class="mt-6 space-y-6"
    >
      <section class="card p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Informations générales</h2>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label class="field-label" for="title">Titre de l’intervention</label>
            <input class="field-input" type="text" id="title" name="title" required maxlength="180"
              value="<%= intervention ? intervention.title : '' %>" placeholder="Ex. Remplacement disque défaillant baie SAN" />
          </div>
          <div>
            <label class="field-label" for="type">Type</label>
            <select class="field-select" id="type" name="type">
              <% TYPES.forEach(function (t) { %>
                <option value="<%= t %>" <%= intervention && intervention.type === t ? 'selected' : '' %>>
                  <%= ({maintenance:'Maintenance préventive',incident:"Résolution d'incident",installation:'Installation / Déploiement',audit:'Audit / Contrôle',autre:'Autre'})[t] %>
                </option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="field-label" for="priority">Priorité</label>
            <select class="field-select" id="priority" name="priority">
              <% PRIORITIES.forEach(function (p) { %>
                <option value="<%= p %>" <%= (intervention ? intervention.priority : 'normale') === p ? 'selected' : '' %>>
                  <%= ({basse:'Basse',normale:'Normale',haute:'Haute',critique:'Critique'})[p] %>
                </option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="field-label" for="status">Statut</label>
            <select class="field-select" id="status" name="status">
              <% STATUSES.forEach(function (s) { %>
                <option value="<%= s %>" <%= (intervention ? intervention.status : 'planifie') === s ? 'selected' : '' %>>
                  <%= ({planifie:'Planifiée',en_cours:'En cours',termine:'Terminée',annule:'Annulée'})[s] %>
                </option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="field-label" for="intervention_date">Date d’intervention</label>
            <input class="field-input" type="date" id="intervention_date" name="intervention_date" required
              value="<%= intervention ? intervention.intervention_date : '' %>" />
          </div>
          <div>
            <label class="field-label" for="start_time">Heure de début</label>
            <input class="field-input" type="time" id="start_time" name="start_time" value="<%= intervention ? (intervention.start_time || '') : '' %>" />
          </div>
          <div>
            <label class="field-label" for="end_time">Heure de fin</label>
            <input class="field-input" type="time" id="end_time" name="end_time" value="<%= intervention ? (intervention.end_time || '') : '' %>" />
          </div>
        </div>
      </section>

      <%
        let datacenterMode = intervention && !intervention.datacenter_id ? 'manual' : 'registered';
        const selectedDatacenterId = preselectedDatacenter ? preselectedDatacenter.id : (intervention ? intervention.datacenter_id : null);
        if (preselectedDatacenter) datacenterMode = 'registered';
      %>
      <section class="card p-6" id="datacenter-section">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">DataCenter</h2>
          <a href="/datacenters/new?returnTo=<%= encodeURIComponent(intervention ? '/interventions/' + intervention.id + '/edit' : '/interventions/new') %>" class="text-xs font-semibold text-teal-600 hover:text-teal-700">+ Nouveau DataCenter</a>
        </div>

        <div class="mt-4 inline-flex flex-wrap gap-1 rounded-lg border border-ink-100 bg-ink-50 p-1" id="datacenter-mode-toggle">
          <label class="cursor-pointer">
            <input type="radio" name="datacenter_mode" value="registered" class="peer sr-only" <%= datacenterMode === 'registered' ? 'checked' : '' %> />
            <span class="block rounded-md px-3 py-1.5 text-sm font-medium text-ink-500 transition peer-checked:bg-white peer-checked:text-ink-900 peer-checked:shadow-sm">DataCenter enregistré</span>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="datacenter_mode" value="manual" class="peer sr-only" <%= datacenterMode === 'manual' ? 'checked' : '' %> />
            <span class="block rounded-md px-3 py-1.5 text-sm font-medium text-ink-500 transition peer-checked:bg-white peer-checked:text-ink-900 peer-checked:shadow-sm">Autre / ponctuel</span>
          </label>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 <%= datacenterMode === 'registered' ? '' : 'hidden' %>" data-datacenter-panel="registered">
          <div>
            <label class="field-label" for="datacenter_id">DataCenter</label>
            <select class="field-select" id="datacenter_id" name="datacenter_id" <%= datacenterMode === 'registered' ? '' : 'disabled' %>>
              <option value="">— Sélectionner un DataCenter —</option>
              <% datacentersList.forEach(function (d) { %>
                <option value="<%= d.id %>" <%= String(selectedDatacenterId) === String(d.id) ? 'selected' : '' %>><%= d.name %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="field-label" for="datacenter_address_registered">Adresse (optionnel)</label>
            <input class="field-input" type="text" id="datacenter_address_registered" name="datacenter_address" <%= datacenterMode === 'registered' ? '' : 'disabled' %>
              value="<%= intervention && intervention.datacenter_id ? (intervention.datacenter_address || '') : '' %>" />
          </div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 <%= datacenterMode === 'manual' ? '' : 'hidden' %>" data-datacenter-panel="manual">
          <div>
            <label class="field-label" for="datacenter_name_manual">Nom du DataCenter</label>
            <input class="field-input" type="text" id="datacenter_name_manual" name="datacenter_name" <%= datacenterMode === 'manual' ? '' : 'disabled' %>
              value="<%= intervention && !intervention.datacenter_id ? intervention.datacenter_name : '' %>" placeholder="Ex. Equinix PA3" />
          </div>
          <div>
            <label class="field-label" for="datacenter_address_manual">Adresse</label>
            <input class="field-input" type="text" id="datacenter_address_manual" name="datacenter_address" <%= datacenterMode === 'manual' ? '' : 'disabled' %>
              value="<%= intervention && !intervention.datacenter_id ? (intervention.datacenter_address || '') : '' %>" />
          </div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="datacenter_room">Salle</label>
            <input class="field-input" type="text" id="datacenter_room" name="datacenter_room"
              value="<%= intervention ? (intervention.datacenter_room || '') : '' %>" placeholder="Ex. Salle 2" />
          </div>
          <div>
            <label class="field-label" for="rack_reference">Baie / Rack</label>
            <input class="field-input" type="text" id="rack_reference" name="rack_reference"
              value="<%= intervention ? (intervention.rack_reference || '') : '' %>" placeholder="Ex. B12-R04" />
          </div>
        </div>
      </section>

      <%
        let clientMode = 'registered';
        if (intervention && intervention.is_internal) clientMode = 'internal';
        else if (intervention && !intervention.client_id) clientMode = 'manual';
        const selectedClientId = preselectedClient ? preselectedClient.id : (intervention ? intervention.client_id : null);
      %>
      <section class="card p-6" id="client-section">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Client</h2>
          <a href="/clients/new?returnTo=<%= encodeURIComponent(intervention ? '/interventions/' + intervention.id + '/edit' : '/interventions/new') %>" class="text-xs font-semibold text-teal-600 hover:text-teal-700">+ Nouveau client</a>
        </div>

        <div class="mt-4 inline-flex flex-wrap gap-1 rounded-lg border border-ink-100 bg-ink-50 p-1" id="client-mode-toggle">
          <label class="cursor-pointer">
            <input type="radio" name="client_mode" value="registered" class="peer sr-only" <%= clientMode === 'registered' ? 'checked' : '' %> />
            <span class="block rounded-md px-3 py-1.5 text-sm font-medium text-ink-500 transition peer-checked:bg-white peer-checked:text-ink-900 peer-checked:shadow-sm">Client enregistré</span>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="client_mode" value="manual" class="peer sr-only" <%= clientMode === 'manual' ? 'checked' : '' %> />
            <span class="block rounded-md px-3 py-1.5 text-sm font-medium text-ink-500 transition peer-checked:bg-white peer-checked:text-ink-900 peer-checked:shadow-sm">Client ponctuel</span>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="client_mode" value="internal" class="peer sr-only" <%= clientMode === 'internal' ? 'checked' : '' %> />
            <span class="block rounded-md px-3 py-1.5 text-sm font-medium text-ink-500 transition peer-checked:bg-white peer-checked:text-ink-900 peer-checked:shadow-sm">Intervention interne</span>
          </label>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 <%= clientMode === 'registered' ? '' : 'hidden' %>" data-client-panel="registered">
          <div>
            <label class="field-label" for="client_id">Client</label>
            <select class="field-select" id="client_id" name="client_id" <%= clientMode === 'registered' ? '' : 'disabled' %>>
              <option value="">— Sélectionner un client —</option>
              <% clientsList.forEach(function (c) { %>
                <option value="<%= c.id %>" <%= String(selectedClientId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="field-label" for="client_contact_registered">Contact (optionnel)</label>
            <input class="field-input" type="text" id="client_contact_registered" name="client_contact" <%= clientMode === 'registered' ? '' : 'disabled' %>
              value="<%= intervention && intervention.client_id ? (intervention.client_contact || '') : '' %>" placeholder="Nom — fonction" />
          </div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 <%= clientMode === 'manual' ? '' : 'hidden' %>" data-client-panel="manual">
          <div>
            <label class="field-label" for="client_name_manual">Nom du client</label>
            <input class="field-input" type="text" id="client_name_manual" name="client_name" <%= clientMode === 'manual' ? '' : 'disabled' %>
              value="<%= intervention && !intervention.client_id && !intervention.is_internal ? intervention.client_name : '' %>" placeholder="Ex. ACME Corp" />
          </div>
          <div>
            <label class="field-label" for="client_contact_manual">Contact</label>
            <input class="field-input" type="text" id="client_contact_manual" name="client_contact" <%= clientMode === 'manual' ? '' : 'disabled' %>
              value="<%= intervention && !intervention.client_id && !intervention.is_internal ? (intervention.client_contact || '') : '' %>" placeholder="Nom — fonction" />
          </div>
        </div>

        <div class="mt-4 rounded-lg border border-dashed border-ink-200 bg-ink-50 px-4 py-3 text-sm text-ink-500 <%= clientMode === 'internal' ? '' : 'hidden' %>" data-client-panel="internal">
          Intervention sans client — maintenance, tests ou travaux internes Shiftek Hosting. Aucune information client ne sera demandée ni affichée sur le rapport.
        </div>

        <input type="checkbox" name="is_internal" id="is_internal_flag" class="hidden" <%= clientMode === 'internal' ? 'checked' : '' %> />
      </section>

      <section class="card p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Intervenants</h2>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="technician_name">Technicien principal</label>
            <input class="field-input" list="technicians" type="text" id="technician_name" name="technician_name" required
              value="<%= intervention ? intervention.technician_name : (currentUser ? currentUser.fullName : '') %>" />
            <datalist id="technicians"><% technicians.forEach(function (t) { %><option value="<%= t %>"></option><% }) %></datalist>
          </div>
          <div>
            <label class="field-label" for="additional_technicians">Techniciens additionnels</label>
            <input class="field-input" type="text" id="additional_technicians" name="additional_technicians"
              value="<%= intervention ? (intervention.additional_technicians || '') : '' %>" placeholder="Optionnel" />
          </div>
        </div>
      </section>

      <section class="card p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Détails de l’intervention</h2>
        <div class="mt-4 space-y-4">
          <div>
            <label class="field-label" for="context">Contexte / objectif</label>
            <textarea class="field-textarea" id="context" name="context" rows="3"><%= intervention ? (intervention.context || '') : '' %></textarea>
          </div>
          <div>
            <label class="field-label" for="actions_taken">Actions réalisées</label>
            <textarea class="field-textarea" id="actions_taken" name="actions_taken" rows="4"><%= intervention ? (intervention.actions_taken || '') : '' %></textarea>
          </div>
          <div>
            <label class="field-label" for="equipment_involved">Matériel concerné</label>
            <textarea class="field-textarea" id="equipment_involved" name="equipment_involved" rows="2"><%= intervention ? (intervention.equipment_involved || '') : '' %></textarea>
          </div>
          <div>
            <label class="field-label" for="incidents">Incidents rencontrés</label>
            <textarea class="field-textarea" id="incidents" name="incidents" rows="3"><%= intervention ? (intervention.incidents || '') : '' %></textarea>
          </div>
          <div>
            <label class="field-label" for="recommendations">Recommandations</label>
            <textarea class="field-textarea" id="recommendations" name="recommendations" rows="3"><%= intervention ? (intervention.recommendations || '') : '' %></textarea>
          </div>
        </div>
      </section>

      <section class="card p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Photos</h2>
        <p class="mt-1 text-xs text-ink-400">JPEG, PNG ou WEBP — 8 Mo max par photo, 10 photos max.</p>

        <% if (intervention && photos && photos.length) { %>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <% photos.forEach(function (p) { %>
              <label class="group relative block overflow-hidden rounded-xl border border-ink-100">
                <img src="/uploads/photos/<%= p %>" class="h-28 w-full object-cover" alt="Photo intervention" />
                <span class="absolute inset-0 flex items-center justify-center gap-2 bg-ink-900/0 opacity-0 transition group-has-[:checked]:bg-red-900/50 group-has-[:checked]:opacity-100">
                  <span class="rounded-full bg-white px-2 py-1 text-xs font-semibold text-red-700">Supprimée</span>
                </span>
                <input type="checkbox" name="remove_photos" value="<%= p %>" class="absolute right-1.5 top-1.5 h-4 w-4 rounded border-white" />
              </label>
            <% }) %>
          </div>
          <p class="mt-1 text-xs text-ink-400">Cochez une photo pour la retirer du rapport.</p>
        <% } %>

        <div class="mt-4">
          <input class="field-input" type="file" id="photos" name="photos" accept="image/jpeg,image/png,image/webp" multiple />
          <div id="photo-preview" class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4"></div>
        </div>
      </section>

      <section class="card p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Signatures</h2>
        <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <label class="field-label">Signature technicien</label>
            <div class="signature-pad rounded-xl border border-dashed border-ink-200 bg-ink-50" data-target="technician_signature_data">
              <canvas class="h-40 w-full cursor-crosshair rounded-xl bg-white" width="500" height="220"></canvas>
            </div>
            <button type="button" class="btn-secondary mt-2 !py-1.5 signature-clear">Effacer</button>
            <input type="hidden" name="technician_signature_data" value="<%= intervention ? (intervention.technician_signature_data || '') : '' %>" />
          </div>
          <div id="client-signature-block" class="<%= clientMode === 'internal' ? 'hidden' : '' %>">
            <label class="field-label" for="client_signature_name">Nom du représentant client</label>
            <input class="field-input" type="text" id="client_signature_name" name="client_signature_name" <%= clientMode === 'internal' ? 'disabled' : '' %>
              value="<%= intervention ? (intervention.client_signature_name || '') : '' %>" />
            <label class="field-label mt-3">Signature client</label>
            <p class="text-xs text-ink-400">Sur place uniquement. Le client peut aussi signer à distance via le lien généré après création du rapport.</p>
            <div class="signature-pad mt-1.5 rounded-xl border border-dashed border-ink-200 bg-ink-50" data-target="client_signature_data">
              <canvas class="h-40 w-full cursor-crosshair rounded-xl bg-white" width="500" height="220"></canvas>
            </div>
            <button type="button" class="btn-secondary mt-2 !py-1.5 signature-clear">Effacer</button>
            <input type="hidden" name="client_signature_data" value="<%= intervention ? (intervention.client_signature_data || '') : '' %>" />
          </div>
        </div>
      </section>

      <div class="flex items-center justify-end gap-3">
        <a href="/" class="btn-secondary">Annuler</a>
        <button type="submit" class="btn-accent">
          <%= intervention ? 'Enregistrer les modifications' : 'Créer le rapport' %>
        </button>
      </div>
    </form>
  </main>
<%- include('partials/foot') %>
