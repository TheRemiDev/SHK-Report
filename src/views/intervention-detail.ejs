<%
  const statusMap = {
    planifie: ['Planifiée', 'bg-ink-100 text-ink-600'],
    en_cours: ['En cours', 'bg-sky-100 text-sky-700'],
    termine: ['Terminée', 'bg-teal-100 text-teal-700'],
    annule: ['Annulée', 'bg-red-100 text-red-700'],
  };
  const st = statusMap[intervention.status] || ['—', 'bg-ink-100 text-ink-600'];
  const typeLabels = { maintenance: 'Maintenance préventive', incident: "Résolution d'incident", installation: 'Installation / Déploiement', audit: 'Audit / Contrôle', autre: 'Autre' };
  const priorityLabels = { basse: 'Basse', normale: 'Normale', haute: 'Haute', critique: 'Critique' };
  const fmtDate = (d) => d ? new Date(d + 'T00:00:00').toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) : '—';
%>
<%- include('partials/head') %>
  <%- include('partials/nav') %>

  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex items-start gap-3">
        <a href="/" class="btn-ghost !px-2 mt-1"><svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"/></svg></a>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold text-ink-900"><%= intervention.reference %></h1>
            <span class="badge <%= st[1] %>"><%= st[0] %></span>
          </div>
          <p class="mt-1 text-sm text-ink-500"><%= intervention.title %></p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/interventions/<%= intervention.id %>/pdf" class="btn-accent">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v7.19l2.72-2.72a.75.75 0 111.06 1.06l-4 4a.75.75 0 01-1.06 0l-4-4a.75.75 0 111.06-1.06l2.72 2.72V3.75A.75.75 0 0110 3zM4 15.75A.75.75 0 014.75 15h10.5a.75.75 0 010 1.5H4.75a.75.75 0 01-.75-.75z" clip-rule="evenodd"/></svg>
          Télécharger le PDF
        </a>
        <a href="/interventions/<%= intervention.id %>/edit" class="btn-secondary">Modifier</a>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <form action="/interventions/<%= intervention.id %>/delete" method="post" data-confirm="Supprimer définitivement ce rapport ?">
            <button type="submit" class="btn-danger">Supprimer</button>
          </form>
        <% } %>
      </div>
    </div>

    <%- include('partials/flash') %>

    <div class="mt-6 card p-6">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        <div>
          <p class="field-label">Client</p>
          <p class="text-sm font-medium text-ink-900"><%= intervention.client_name %></p>
          <p class="text-xs text-ink-400"><%= intervention.client_contact || '' %></p>
        </div>
        <div>
          <p class="field-label">DataCenter</p>
          <p class="text-sm font-medium text-ink-900"><%= intervention.datacenter_name %></p>
          <p class="text-xs text-ink-400"><%= [intervention.datacenter_room, intervention.rack_reference].filter(Boolean).join(' · ') %></p>
        </div>
        <div>
          <p class="field-label">Date d’intervention</p>
          <p class="text-sm font-medium text-ink-900"><%= fmtDate(intervention.intervention_date) %></p>
          <p class="text-xs text-ink-400"><%= intervention.start_time || '—' %> - <%= intervention.end_time || '—' %></p>
        </div>
        <div>
          <p class="field-label">Technicien(s)</p>
          <p class="text-sm font-medium text-ink-900"><%= intervention.technician_name %></p>
          <p class="text-xs text-ink-400"><%= intervention.additional_technicians || '' %></p>
        </div>
        <div>
          <p class="field-label">Type</p>
          <p class="text-sm font-medium text-ink-900"><%= typeLabels[intervention.type] || intervention.type %></p>
        </div>
        <div>
          <p class="field-label">Priorité</p>
          <p class="text-sm font-medium text-ink-900"><%= priorityLabels[intervention.priority] || intervention.priority %></p>
        </div>
      </div>
    </div>

    <div class="mt-6 space-y-6">
      <% const sections = [
        ['Contexte de l’intervention', intervention.context],
        ['Actions réalisées', intervention.actions_taken],
        ['Matériel concerné', intervention.equipment_involved],
        ['Incidents rencontrés', intervention.incidents],
        ['Recommandations', intervention.recommendations],
      ]; %>
      <% sections.forEach(function ([label, value]) { if (!value) return; %>
        <div class="card p-6">
          <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-teal-600">
            <span class="h-3 w-1 rounded-full bg-teal-500"></span><%= label %>
          </h2>
          <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink-700"><%= value %></p>
        </div>
      <% }) %>

      <% if (photos && photos.length) { %>
        <div class="card p-6">
          <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-teal-600">
            <span class="h-3 w-1 rounded-full bg-teal-500"></span>Photos (<%= photos.length %>)
          </h2>
          <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <% photos.forEach(function (p) { %>
              <a href="/uploads/photos/<%= p %>" target="_blank" rel="noopener" class="block overflow-hidden rounded-xl border border-ink-100">
                <img src="/uploads/photos/<%= p %>" class="h-32 w-full object-cover transition hover:scale-105" alt="Photo intervention" />
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="card p-6">
        <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-teal-600">
          <span class="h-3 w-1 rounded-full bg-teal-500"></span>Signatures
        </h2>
        <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-ink-100 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-400">Technicien ShifTek</p>
            <% if (intervention.technician_signature_data) { %>
              <img src="<%= intervention.technician_signature_data %>" class="mt-2 h-24" alt="Signature technicien" />
            <% } else { %>
              <p class="mt-6 text-xs italic text-ink-300">Aucune signature enregistrée</p>
            <% } %>
            <p class="mt-2 text-sm font-medium text-ink-900"><%= intervention.technician_name %></p>
          </div>
          <div class="rounded-xl border border-ink-100 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-400">Représentant client</p>
            <% if (intervention.client_signature_data) { %>
              <img src="<%= intervention.client_signature_data %>" class="mt-2 h-24" alt="Signature client" />
            <% } else { %>
              <p class="mt-6 text-xs italic text-ink-300">Aucune signature enregistrée</p>
            <% } %>
            <p class="mt-2 text-sm font-medium text-ink-900"><%= intervention.client_signature_name || '—' %></p>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-6 text-xs text-ink-400">
      Rapport créé le <%= new Date(intervention.created_at.replace(' ', 'T')).toLocaleString('fr-FR') %>
      <% if (intervention.updated_at && intervention.updated_at !== intervention.created_at) { %>
        · dernière modification le <%= new Date(intervention.updated_at.replace(' ', 'T')).toLocaleString('fr-FR') %>
      <% } %>
    </p>
  </main>
<%- include('partials/foot') %>
