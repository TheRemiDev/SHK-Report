<%
  const statusMap = {
    planifie: ['Planifiée', 'bg-ink-100 text-ink-600'],
    en_cours: ['En cours', 'bg-sky-100 text-sky-700'],
    termine: ['Terminée', 'bg-teal-100 text-teal-700'],
    annule: ['Annulée', 'bg-red-100 text-red-700'],
  };
  const st = statusMap[intervention.status] || ['—', 'bg-ink-100 text-ink-600'];
  const typeLabels = { maintenance: 'Maintenance préventive', incident: "Résolution d'incident", installation: 'Installation / Déploiement', audit: 'Audit / Contrôle', autre: 'Autre' };
  const fmtDate = (d) => d ? new Date(d + 'T00:00:00').toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) : '—';
  const isSigned = !!intervention.client_signed_at;
%><!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · <%= company.company_name %></title>
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="min-h-screen bg-ink-100 font-sans text-ink-900 antialiased">
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <div class="mb-6 flex items-center justify-between">
      <%- include('partials/logo-mark', { variant: 'compact', className: 'h-7 w-auto text-ink-900' }) %>
      <p class="text-xs text-ink-400">Document transmis par <%= company.company_name %></p>
    </div>

    <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-pop">
      <div class="bg-ink-900 px-8 py-10">
        <%- include('partials/logo-mark', { variant: 'full', className: 'h-9 w-auto text-white' }) %>
        <h1 class="mt-6 text-2xl font-bold text-white">Rapport d’intervention</h1>
        <p class="mt-1 text-sm text-ink-300"><%= intervention.title %></p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="badge <%= st[1] %>"><%= st[0] %></span>
          <span class="rounded-full bg-white/10 px-2.5 py-1 text-xs font-semibold text-white"><%= intervention.reference %></span>
        </div>
      </div>

      <div class="px-8 py-8">
        <div class="grid grid-cols-1 gap-6 rounded-xl border border-ink-100 bg-ink-50 p-5 sm:grid-cols-3">
          <div>
            <p class="field-label">Client</p>
            <p class="text-sm font-medium text-ink-900"><%= intervention.client_name %></p>
          </div>
          <div>
            <p class="field-label">DataCenter</p>
            <p class="text-sm font-medium text-ink-900"><%= intervention.datacenter_name %></p>
            <p class="text-xs text-ink-400"><%= [intervention.datacenter_room, intervention.rack_reference].filter(Boolean).join(' · ') %></p>
          </div>
          <div>
            <p class="field-label">Date d’intervention</p>
            <p class="text-sm font-medium text-ink-900"><%= fmtDate(intervention.intervention_date) %></p>
            <p class="text-xs text-ink-400"><%= intervention.start_time || '—' %> - <%= intervention.end_time || '—' %></p>
          </div>
          <div>
            <p class="field-label">Technicien</p>
            <p class="text-sm font-medium text-ink-900"><%= intervention.technician_name %></p>
          </div>
          <div>
            <p class="field-label">Type d’intervention</p>
            <p class="text-sm font-medium text-ink-900"><%= typeLabels[intervention.type] || intervention.type %></p>
          </div>
        </div>

        <div class="mt-8">
          <%- include('partials/flash') %>
        </div>

        <div class="mt-2 space-y-6">
          <% const sections = [
            ['Contexte de l’intervention', intervention.context],
            ['Actions réalisées', intervention.actions_taken],
            ['Matériel concerné', intervention.equipment_involved],
            ['Incidents rencontrés', intervention.incidents],
            ['Recommandations', intervention.recommendations],
          ]; %>
          <% sections.forEach(function ([label, value]) { if (!value) return; %>
            <div>
              <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-teal-600">
                <span class="h-3 w-1 rounded-full bg-teal-500"></span><%= label %>
              </h2>
              <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-ink-700"><%= value %></p>
            </div>
          <% }) %>

          <% if (photos && photos.length) { %>
            <div>
              <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-teal-600">
                <span class="h-3 w-1 rounded-full bg-teal-500"></span>Photos (<%= photos.length %>)
              </h2>
              <div class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-3">
                <% photos.forEach(function (p) { %>
                  <a href="/uploads/photos/<%= p %>" target="_blank" rel="noopener" class="block overflow-hidden rounded-xl border border-ink-100">
                    <img src="/uploads/photos/<%= p %>" class="h-28 w-full object-cover" alt="Photo intervention" />
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>

        <div class="mt-10 border-t border-ink-100 pt-8">
          <h2 class="text-sm font-bold uppercase tracking-wide text-teal-600">Signatures</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-ink-100 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-400">Technicien Shiftek</p>
              <% if (intervention.technician_signature_data) { %>
                <img src="<%= intervention.technician_signature_data %>" class="mt-2 h-20" alt="Signature technicien" />
              <% } else { %>
                <p class="mt-6 text-xs italic text-ink-300">Non signé</p>
              <% } %>
              <p class="mt-2 text-sm font-medium text-ink-900"><%= intervention.technician_name %></p>
            </div>

            <div class="rounded-xl border border-ink-100 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-400">Représentant client</p>
              <% if (isSigned) { %>
                <img src="<%= intervention.client_signature_data %>" class="mt-2 h-20" alt="Signature client" />
                <p class="mt-2 text-sm font-medium text-ink-900"><%= intervention.client_signature_name || '—' %></p>
                <p class="text-xs text-ink-400">Signé le <%= new Date(intervention.client_signed_at.replace(' ', 'T')).toLocaleDateString('fr-FR') %></p>
              <% } else { %>
                <p class="mt-6 text-xs italic text-ink-300">En attente de votre signature ci-dessous</p>
              <% } %>
            </div>
          </div>
        </div>

        <% if (isSigned) { %>
          <div class="mt-6 flex items-center gap-3 rounded-xl border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-800">
            <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
            Document signé électroniquement. Merci.
          </div>
          <a href="/share/<%= intervention.share_token %>/pdf" class="btn-accent mt-4">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v7.19l2.72-2.72a.75.75 0 111.06 1.06l-4 4a.75.75 0 01-1.06 0l-4-4a.75.75 0 111.06-1.06l2.72 2.72V3.75A.75.75 0 0110 3zM4 15.75A.75.75 0 014.75 15h10.5a.75.75 0 010 1.5H4.75a.75.75 0 01-.75-.75z" clip-rule="evenodd"/></svg>
            Télécharger le PDF signé
          </a>
          <p class="mt-2 text-xs text-ink-400">Ce lien de consultation sera désactivé après le téléchargement.</p>
        <% } else { %>
          <div class="mt-6 rounded-xl border border-ink-100 bg-ink-50 p-5">
            <h3 class="text-sm font-semibold text-ink-900">Signer ce rapport</h3>
            <p class="mt-1 text-xs text-ink-500">
              En signant, vous confirmez avoir pris connaissance de ce rapport d’intervention.
            </p>
            <form action="/share/<%= intervention.share_token %>/sign" method="post" class="mt-4 space-y-4">
              <div>
                <label class="field-label" for="name">Votre nom</label>
                <input class="field-input max-w-sm" type="text" id="name" name="name" required value="<%= intervention.client_signature_name || '' %>" />
              </div>
              <div>
                <label class="field-label">Signature</label>
                <div class="signature-pad rounded-xl border border-dashed border-ink-200 bg-white" data-target="signature">
                  <canvas class="h-40 w-full touch-none select-none cursor-crosshair rounded-xl bg-white" width="600" height="220"></canvas>
                </div>
                <button type="button" class="btn-secondary mt-2 !py-1.5 signature-clear">Effacer</button>
                <input type="hidden" name="signature" value="" />
              </div>
              <button type="submit" class="btn-accent">Signer le rapport</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-ink-400">
      <%= company.company_name %><% if (company.company_website) { %> · <%= company.company_website %><% } %>
      — document confidentiel destiné exclusivement à son destinataire.
    </p>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
