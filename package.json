{
  "name": "shk-report",
  "version": "1.0.0",
  "description": "Générateur de rapports d'intervention DataCenter - ShifTek Hosting",
  "private": true,
  "license": "UNLICENSED",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/style.css --watch",
    "build": "npm run build:css",
    "migrate": "node src/db/migrate.js",
    "create-admin": "node src/cli/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "better-sqlite3-session-store": "^0.1.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.15.0",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
