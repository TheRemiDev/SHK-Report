# Copie ce fichier en ".env" (l'installateur le fait automatiquement)

# Port interne sur lequel l'application écoute (Nginx fait le reverse-proxy)
PORT=3000

# Domaine complet configuré pendant l'installation (ex: rapports.shiftek.fr)
APP_DOMAIN=localhost

# Nom de la société affiché dans l'interface et les PDF
COMPANY_NAME=ShifTek Hosting

# Secret de session (généré automatiquement par install.sh)
SESSION_SECRET=change-me

# Environnement
NODE_ENV=production

# Emplacement des données (base SQLite + fichiers uploadés)
DATA_DIR=./data
UPLOAD_DIR=./uploads
